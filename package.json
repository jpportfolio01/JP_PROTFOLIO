{
  "name": "jitendra-parmar-lab-root",
  "version": "1.0.0",
  "description": "Root workspace runner for Dr. Jitendra Parmar Academic Portal & JUET Virtual Lab Backend",
  "scripts": {
    "start": "cd backend && npm start",
    "backend": "cd backend && npm start",
    "backend:dev": "cd backend && npm run dev",
