# ===============================================================
# Dr. Jitendra Parmar - JUET Virtual Lab Environment Variables
# ===============================================================

# 1. Server Port
# Automatically assigned by Render in production (e.g. 10000).
# Leave commented or set to 5001 for local development.
PORT=5001

# 2. Node Environment
# Recommended value on Render: production
NODE_ENV=production

# 3. Google Official OAuth 2.0 Web Client ID
# Required for Google Identity Services / institutional sign-in.
# Format: <number>-<alphanumeric>.apps.googleusercontent.com
GOOGLE_CLIENT_ID=

# 4. Optional: Custom Admin Suite Credentials
# Overrides default admin credentials in the Administration Suite
ADMIN_USERNAME=adminparmar
ADMIN_PASSWORD=JITENDRAPARMAR

# 5. GitHub Cloud Persistence & Auto-Sync
# Required if you want changes made in the live Admin Portal on Render
# to automatically commit back to GitHub so they survive redeployments.
# Create a classic personal access token on GitHub with 'repo' scope.
GITHUB_TOKEN=
GITHUB_REPO=jpportfolio01/JP_PROTFOLIO
GITHUB_BRANCH=main

# 6. Optional: Auto-Deploy Hooks (Guaranteed Immediate Live Redeployment)
# Vercel: Project Settings -> Git -> Deploy Hooks
VERCEL_DEPLOY_HOOK_URL=
# Render: Web Service Settings -> Deploy Hook
RENDER_DEPLOY_HOOK_URL=
